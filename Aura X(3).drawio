        <mxCell id="jZZxc91wZ2d6JWRdRUgt-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;perimeterSpacing=3;roundedPerimeter=1;fillColor=light-dark(#1BA1E2,#FFFF66);fontColor=#ffffff;strokeColor=#006EAF;glass=0;shadow=0;" value="&lt;div&gt;(4)&lt;/div&gt;&lt;div&gt;Logic&lt;/div&gt;" vertex="1">
