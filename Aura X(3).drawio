        <mxCell id="jZZxc91wZ2d6JWRdRUgt-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;perimeterSpacing=3;roundedPerimeter=1;fillColor=light-dark(#1BA1E2,#FF66FF);fontColor=#ffffff;strokeColor=#006EAF;glass=0;shadow=0;" value="&lt;div&gt;(3)&lt;/div&gt;&lt;div&gt;Sound&lt;/div&gt;" vertex="1">
