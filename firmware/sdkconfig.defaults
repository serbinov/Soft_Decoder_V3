# DCC decoder V3: baseline ESP-IDF defaults
# Custom partition table (single app + internal SPIFFS fallback).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# 1 ms tick: delays assume a 1 kHz tick.
CONFIG_FREERTOS_HZ=1000

# Detect task stack overflow (canary on task switch) so an overflow panics with
# the task name instead of silently corrupting the heap (heap corruption looked
# like a random FreeRTOS assert in xTaskRemoveFromEventList).
CONFIG_FREERTOS_CHECK_STACKOVERFLOW=1

# app_main() starts Wi-Fi (esp_wifi_init needs ~10 KB stack).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Core dump to the coredump partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# OTA rollback: a freshly OTA-updated image boots as PENDING_VERIFY and is only
# kept once app_main confirms it (esp_ota_mark_app_valid_cancel_rollback). If it
# crashes before that, the bootloader restores the previous image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Power management DISABLED: light sleep would put the softAP radio into a
# ~830 ms sleep cycle and throttle uploads to ~2 KB/s.
# CONFIG_PM_ENABLE is not set

# Captive portal browsers send long headers (431 otherwise).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# 4MB flash used by the partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# LittleFS (internal fallback + external W25Q128, 4 KB erase blocks).
# prog/read size match the flash page (256 B) and a larger cache cuts metadata
# re-reads. Wear-leveling stays on (default 512 block cycles).
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
CONFIG_LITTLEFS_READ_SIZE=256
CONFIG_LITTLEFS_WRITE_SIZE=256
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=1024

# Upload speed: 16384 is the proven optimum for softAP uploads.
CONFIG_LWIP_TCP_WND_DEFAULT=16384
# Two httpd servers (80 + 81) + DNS hijack + client connections. The phone's
# browser opens several keep-alive connections and leaves sockets in TIME_WAIT;
# with the old 14/60 s limits httpd_accept_conn failed with ENFILE (23) and API
# responses (e.g. /api/audio/tracks) were dropped. Enlarge the pool and shorten
# TIME_WAIT (2 x MSL) so closed sockets are recycled quickly.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=16
CONFIG_LWIP_MAX_LISTENING_TCP=16
CONFIG_LWIP_TCP_MSL=15000

# WPA3 disabled to save flash (AP/STA use WPA2).
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set

CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MBEDTLS_TLS_SERVER is not set
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_NEWLIB_NANO_FORMAT=y

# IPv6 disabled: the decoder runs an IPv4-only softAP/captive portal. This
# drops nd6/ip6/ICMPv6 from lwIP and saves ~10-15 KB of flash.
CONFIG_LWIP_IPV6=n

# ESP32-S3FH4R2 has 2 MB in-package QUAD PSRAM. Enable it and integrate into
# malloc() so large buffers can spill into PSRAM instead of internal SRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
