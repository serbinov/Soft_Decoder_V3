node_modules/
.vite/
test-results/
playwright-report/

# The built editor is committed so a fresh clone works without running npm
# (the local preview serves dist/ directly). Rebuild with `npm run build`
# after editing src/ and commit the updated bundle.
dist/*
!dist/index.html
!dist/blocks.html
!dist/build-inputs.json
!dist/THIRD_PARTY_NOTICES.txt
!dist/assets/
# Gzip copies and size/build reports are regenerated by the build and are not
# needed at runtime (gen_sound_editor.py compresses assets itself).
dist/assets/*.gz
